# 复制本文件为 .env，再填入真实值；.env 不会进 Git
DJANGO_SECRET_KEY=请替换成你自己的随机字符串
DJANGO_DEBUG=True

# ---------------- 邮件通知（可选）----------------
# 填了 QQ 邮箱的「授权码」→ 真的发信（smtp.qq.com:465，SSL）
# 留空 → 邮件内容打印到服务器控制台，方便本地测试
# QQ 邮箱授权码获取：QQ邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成授权码
EMAIL_HOST_USER=735641057@qq.com
EMAIL_HOST_PASSWORD=
TASK_NOTIFY_EMAIL=735641057@qq.com

# ---------------- ERP 集成（金蝶 K/3 Cloud）----------------
# ERP_MODE=mock    → 连本机假 ERP（独立目录 模拟ERP金蝶系统，端口 9900）
# ERP_MODE=http    → 连真实金蝶，把 ERP_BASE_URL / 账号密码换成真的
# ERP_MODE=offline → 不联网，直接读种子数据（自检、单测用）
ERP_MODE=mock
ERP_BASE_URL=http://127.0.0.1:9900/K3Cloud
ERP_ACCT_ID=5f2c8a9e6b1d4c3f8e7a0b1c2d3e4f5
ERP_USER=api_user
ERP_PASSWORD=api_password
ERP_TIMEOUT=30
# 单次调用最多尝试几次（=1 不重试）；失败后指数退避 1s、2s、4s
ERP_MAX_ATTEMPTS=3
# 独立模拟 ERP 目录，默认项目上一级的「模拟ERP金蝶系统」
# ERP_MOCK_DIR=E:\DeepSeekHarness\prodiction\模拟ERP金蝶系统
